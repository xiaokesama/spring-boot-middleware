<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xiaoke</groupId>
        <artifactId>spring-boot-middleware-lab</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>springboot-redisson</artifactId>
    <name>springboot-redisson</name>
    <description>Redisson：分布式锁（看门狗/可重入/RedLock）、限流器、布隆过滤器、分布式集合</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          这里用 redisson 核心包而不是 redisson-spring-boot-starter：
          starter 会绑定特定版本的 redisson-spring-data，与 Boot 3.4 的 spring-data-redis 版本
          容易出现 "Spring Data Redis version not supported" 之类的兼容问题。
          我们只需要 RedissonClient，手动建一个 Bean 更可控，也更能看清配置项。
        -->
        <dependency>
            <groupId>org.redisson</groupId>
            <artifactId>redisson</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
